{
  "disease": "alzheimer",
  "display_name": "Alzheimer's Risk Assessment",
  "description": "Evaluate the risk of Alzheimer's disease using patient demographics, health history, and lifestyle factors.",
  "icon": "🧠",
  "color": "#9333ea",
  "gradient": "linear-gradient(135deg, #9333ea, #d8b4fe)",
  "output_labels": ["No Alzheimer's Risk", "Alzheimer's Risk"],
  "positive_class": 1,
  "fields": [
    {
      "name": "Age",
      "label": "Age",
      "type": "number",
      "min": 60,
      "max": 90,
      "step": 1,
      "default": 65,
      "description": "Age of the patient",
      "section": "Demographics"
    },
    {
      "name": "Gender",
      "label": "Gender",
      "type": "select",
      "default": "Male",
      "options": [{"label": "Male", "value": "Male"}, {"label": "Female", "value": "Female"}],
      "section": "Demographics"
    },
    {
      "name": "Ethnicity",
      "label": "Ethnicity",
      "type": "select",
      "default": "Caucasian",
      "options": [
        {"label": "Caucasian", "value": "Caucasian"},
        {"label": "African American", "value": "African American"},
        {"label": "Asian", "value": "Asian"},
        {"label": "Other", "value": "Other"}
      ],
      "section": "Demographics"
    },
    {
      "name": "EducationLevel",
      "label": "Education Level",
      "type": "select",
      "default": "Bachelor's",
      "options": [
        {"label": "None", "value": "None"},
        {"label": "High School", "value": "High School"},
        {"label": "Bachelor's", "value": "Bachelor's"},
        {"label": "Higher", "value": "Higher"}
      ],
      "section": "Demographics"
    },
    {
      "name": "BMI",
      "label": "BMI",
      "type": "number",
      "min": 15.0089,
      "max": 39.9928,
      "step": 0.1,
      "default": 24.5,
      "section": "Health Profile"
    },
    {
      "name": "Smoking",
      "label": "Smoking",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Lifestyle"
    },
    {
      "name": "AlcoholConsumption",
      "label": "Alcohol Consumption (0-20)",
      "type": "number",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8,
      "description": "Number of times the person drinks alcohol in a month",
      "section": "Lifestyle"
    },
    {
      "name": "PhysicalActivity",
      "label": "Physical Activity (0-10)",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 6,
      "description": "Number of hours per week the person does physical activity, scaled from 0 to 10",
      "section": "Lifestyle"
    },
    {
      "name": "DietQuality",
      "label": "Diet Quality (0-10)",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 7,
      "description": "Quality of the person's regular diet, where 0 is very unhealthy and 10 is very healthy",
      "section": "Lifestyle"
    },
    {
      "name": "SleepQuality",
      "label": "Sleep Quality (4-10)",
      "type": "number",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 8,
      "description": "Approximate hours of sleep per day",
      "section": "Lifestyle"
    },
    {
      "name": "FamilyHistoryAlzheimers",
      "label": "Family History of Alzheimer's",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Medical History"
    },
    {
      "name": "CardiovascularDisease",
      "label": "Cardiovascular Disease",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Medical History"
    },
    {
      "name": "Diabetes",
      "label": "Diabetes",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Medical History"
    },
    {
      "name": "Depression",
      "label": "Depression",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Mental Health"
    },
    {
      "name": "HeadInjury",
      "label": "Head Injury",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Medical History"
    },
    {
      "name": "Hypertension",
      "label": "Hypertension",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Medical History"
    },
    {
      "name": "MMSE",
      "label": "MMSE (Cognitive Test)",
      "type": "select",
      "default": 28,
      "options": [
        {"label": "Severe Cognitive Impairment (0-9)", "value": 5},
        {"label": "Moderate Cognitive Impairment (10-20)", "value": 15},
        {"label": "Mild Cognitive Impairment (21-24)", "value": 23},
        {"label": "Normal Cognition (25-30)", "value": 28}
      ],
      "section": "Cognitive Health"
    },
    {
      "name": "FunctionalAssessment",
      "label": "Functional Assessment (0-10)",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 7,
      "description": "Ability to manage normal daily life tasks (0=very poor, 10=very good). Scale: 0=fully dependent, 1-3=highly dependent, 4-6=moderately independent, 7-9=mostly independent, 10=fully independent",
      "section": "Cognitive Health"
    },
    {
      "name": "MemoryComplaints",
      "label": "Memory Complaints",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Cognitive Health"
    },
    {
      "name": "BehavioralProblems",
      "label": "Behavioral Problems",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Mental Health"
    },
    {
      "name": "ADL",
      "label": "Activities of Daily Living (ADL) (0-10)",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 5,
      "description": "Ability to do basic daily activities like eating, bathing, dressing, walking, and using the toilet (0=fully dependent, 10=fully independent)",
      "section": "Cognitive Health"
    },
    {
      "name": "Confusion",
      "label": "Confusion",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Symptoms"
    },
    {
      "name": "Disorientation",
      "label": "Disorientation",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Symptoms"
    },
    {
      "name": "PersonalityChanges",
      "label": "Personality Changes",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Symptoms"
    },
    {
      "name": "DifficultyCompletingTasks",
      "label": "Difficulty Completing Tasks",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Symptoms"
    },
    {
      "name": "Forgetfulness",
      "label": "Forgetfulness",
      "type": "select",
      "default": "No",
      "options": [{"label": "No", "value": "No"}, {"label": "Yes", "value": "Yes"}],
      "section": "Symptoms"
    },
    {
      "name": "UrbanRuralLiving",
      "label": "Urban vs Rural Living",
      "type": "select",
      "default": "Urban",
      "options": [{"label": "Rural", "value": "Rural"}, {"label": "Urban", "value": "Urban"}],
      "section": "Socio-Economic"
    },
    {
      "name": "IncomeLevel",
      "label": "Income Level",
      "type": "select",
      "default": "Medium",
      "options": [
        {"label": "Low", "value": "Low"},
        {"label": "Medium", "value": "Medium"},
        {"label": "High", "value": "High"},
        {"label": "Very High", "value": "Very High"}
      ],
      "section": "Socio-Economic"
    },
    {
      "name": "StressLevels",
      "label": "Stress Levels",
      "type": "select",
      "default": "Medium",
      "options": [
        {"label": "Low", "value": "Low"},
        {"label": "Medium", "value": "Medium"},
        {"label": "High", "value": "High"},
        {"label": "Very High", "value": "Very High"}
      ],
      "section": "Mental Health"
    },
    {
      "name": "AirPollutionExposure",
      "label": "Air Pollution Exposure",
      "type": "select",
      "default": "Low",
      "options": [
        {"label": "Low", "value": "Low"},
        {"label": "Medium", "value": "Medium"},
        {"label": "High", "value": "High"},
        {"label": "Very High", "value": "Very High"}
      ],
      "section": "Environment"
    }
  ]
}
