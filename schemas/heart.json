{
  "disease": "heart",
  "display_name": "Heart Disease",
  "description": "Evaluate your cardiovascular risk using clinical, ECG, and angiographic indicators.",
  "icon": "❤️",
  "color": "#f43f5e",
  "gradient": "linear-gradient(135deg, #f43f5e, #e11d48)",
  "output_labels": ["No Heart Disease", "Heart Disease Detected"],
  "positive_class": 1,
  "fields": [
    {
      "name": "age",
      "label": "Age",
      "type": "number",
      "min": 1,
      "max": 120,
      "step": 1,
      "default": 50,
      "unit": "years",
      "description": "Age of the patient",
      "section": "Demographics"
    },
    {
      "name": "sex",
      "label": "Sex",
      "type": "select",
      "options": [
        { "value": 0, "label": "Female" },
        { "value": 1, "label": "Male" }
      ],
      "default": 1,
      "description": "Biological sex",
      "section": "Demographics"
    },
    {
      "name": "cp",
      "label": "Chest Pain Type",
      "type": "select",
      "options": [
        { "value": 0, "label": "Typical Angina" },
        { "value": 1, "label": "Atypical Angina" },
        { "value": 2, "label": "Non-Anginal Pain" },
        { "value": 3, "label": "Asymptomatic" }
      ],
      "default": 1,
      "description": "Type of chest pain experienced",
      "section": "Symptoms"
    },
    {
      "name": "trestbps",
      "label": "Resting Blood Pressure",
      "type": "number",
      "min": 50,
      "max": 250,
      "step": 1,
      "default": 120,
      "unit": "mmHg",
      "description": "Resting blood pressure at hospital admission",
      "section": "Vitals"
    },
    {
      "name": "chol",
      "label": "Serum Cholesterol",
      "type": "number",
      "min": 100,
      "max": 700,
      "step": 1,
      "default": 200,
      "unit": "mg/dL",
      "description": "Serum cholesterol level",
      "section": "Blood Tests"
    },
    {
      "name": "fbs",
      "label": "Fasting Blood Sugar > 120 mg/dL",
      "type": "select",
      "options": [
        { "value": 0, "label": "No  (≤ 120 mg/dL)" },
        { "value": 1, "label": "Yes (> 120 mg/dL)" }
      ],
      "default": 0,
      "description": "Whether fasting blood sugar exceeds 120 mg/dL",
      "section": "Blood Tests"
    },
    {
      "name": "restecg",
      "label": "Resting ECG Results",
      "type": "select",
      "options": [
        { "value": 0, "label": "Normal" },
        { "value": 1, "label": "ST-T Wave Abnormality" },
        { "value": 2, "label": "Left Ventricular Hypertrophy" }
      ],
      "default": 0,
      "description": "Resting electrocardiographic results",
      "section": "ECG"
    },
    {
      "name": "thalach",
      "label": "Maximum Heart Rate Achieved",
      "type": "number",
      "min": 50,
      "max": 250,
      "step": 1,
      "default": 150,
      "unit": "bpm",
      "description": "Maximum heart rate achieved during exercise stress test",
      "section": "ECG"
    },
    {
      "name": "exang",
      "label": "Exercise Induced Angina",
      "type": "select",
      "options": [
        { "value": 0, "label": "No" },
        { "value": 1, "label": "Yes" }
      ],
      "default": 0,
      "description": "Whether exercise induces angina chest pain",
      "section": "Symptoms"
    },
    {
      "name": "oldpeak",
      "label": "ST Depression (Oldpeak)",
      "type": "number",
      "min": 0.0,
      "max": 10.0,
      "step": 0.1,
      "default": 1.0,
      "unit": "mm",
      "description": "ST depression induced by exercise relative to rest",
      "section": "ECG"
    },
    {
      "name": "slope",
      "label": "Slope of Peak Exercise ST Segment",
      "type": "select",
      "options": [
        { "value": 0, "label": "Upsloping" },
        { "value": 1, "label": "Flat" },
        { "value": 2, "label": "Downsloping" }
      ],
      "default": 1,
      "description": "Slope of the peak exercise ST segment",
      "section": "ECG"
    },
    {
      "name": "ca",
      "label": "Number of Major Vessels",
      "type": "select",
      "options": [
        { "value": 0, "label": "0 vessels" },
        { "value": 1, "label": "1 vessel" },
        { "value": 2, "label": "2 vessels" },
        { "value": 3, "label": "3 vessels" }
      ],
      "default": 0,
      "description": "Number of major vessels colored by fluoroscopy (0–3)",
      "section": "Angiography"
    },
    {
      "name": "thal",
      "label": "Thalassemia Type",
      "type": "select",
      "options": [
        { "value": 1, "label": "Normal" },
        { "value": 2, "label": "Fixed Defect" },
        { "value": 3, "label": "Reversible Defect" }
      ],
      "default": 2,
      "description": "Type of thalassemia blood disorder",
      "section": "Blood Tests"
    }
  ]
}
