      "type": "number",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 1,
      "unit": "",
      "description": "Total number of times pregnant (0 for males)",
      "section": "Demographics"
    },
    {
      "name": "Glucose",
      "label": "Plasma Glucose Concentration",
      "type": "number",
      "min": 0,
      "max": 300,
      "step": 1,
      "default": 120,
      "unit": "mg/dL",
      "description": "2-hour plasma glucose in oral glucose tolerance test",
      "section": "Blood Tests"
    },
    {
      "name": "BloodPressure",
      "label": "Diastolic Blood Pressure",
      "type": "number",
      "min": 0,
      "max": 130,
      "step": 1,
      "default": 72,
      "unit": "mmHg",
      "description": "Diastolic blood pressure measurement",
      "section": "Vitals"
    },
    {
      "name": "SkinThickness",
      "label": "Triceps Skin Fold Thickness",
      "type": "number",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "mm",
      "description": "Thickness of the triceps skin fold",
      "section": "Body Measurements"
    },
    {
      "name": "Insulin",
      "label": "2-Hour Serum Insulin",
      "type": "number",
      "min": 0,
      "max": 900,
      "step": 1,
      "default": 80,
      "unit": "μIU/mL",
      "description": "2-hour serum insulin level",
      "section": "Blood Tests"
    },
    {
      "name": "BMI",
      "label": "Body Mass Index (BMI)",
      "type": "number",
      "min": 0,
      "max": 70,
      "step": 0.1,
      "default": 25.0,
      "unit": "kg/m²",
      "description": "Weight in kg divided by height in meters squared",
      "section": "Body Measurements"
    },
    {
      "name": "DiabetesPedigreeFunction",
      "label": "Diabetes Pedigree Function",
      "type": "number",
      "min": 0.0,
      "max": 3.0,
      "step": 0.001,
      "default": 0.5,
      "unit": "",
      "description": "Likelihood of diabetes based on family history (genetic score)",
      "section": "Genetic Factors"
    },
    {
      "name": "Age",
      "label": "Age",
      "type": "number",
      "min": 1,
      "max": 120,
      "step": 1,
      "default": 30,
      "unit": "years",
      "description": "Age of the patient",
      "section": "Demographics"
    }
